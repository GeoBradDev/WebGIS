# Root .gitignore for the WebGIS monorepo.
# Each subproject (backend/, frontend/, mobile/) also has its own .gitignore,
# which git applies within that subtree. This file covers root-level and
# cross-cutting entries.

# Environment files (committed templates are *.env.example)
.env
.env.*
!*.env.example

# IDEs / editors
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Python (belt-and-suspenders; backend/.gitignore is authoritative)
__pycache__/
*.py[cod]
.venv/
venv/

# Node (belt-and-suspenders; frontend|mobile/.gitignore are authoritative)
node_modules/
dist/

# Docker / local data
*.pid

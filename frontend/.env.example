# Frontend (Vite) environment variables. Copy to `.env` and adjust.
# Only VITE_-prefixed vars are exposed to the client, and they are inlined at
# BUILD time, so production values must be set when `npm run build` runs.

# ── Backend API ───────────────────────────────────────────────────────────────
# Base URL of the Django API. The allauth headless base is derived from this.
VITE_API_URL=http://localhost:8000/api

# ── Map data ──────────────────────────────────────────────────────────────────
# Attribute-rich municipalities overlay (GeoJSON). Defaults to the demo ArcGIS
# FeatureServer; point at your own service or a backend endpoint as needed.
VITE_MUNI_GEOJSON_URL=https://services2.arcgis.com/w657bnjzrjguNyOy/ArcGIS/rest/services/Municipal_Boundaries_Line/FeatureServer/1/query?where=1%3D1&outFields=*&f=geojson

# ── PMTiles / MapLibre basemap ────────────────────────────────────────────────
# Basemap vector tiles (single .pmtiles archive built to the Protomaps basemap
# schema, served over HTTP range requests). When set, the map uses a PMTiles
# vector basemap; when blank, it falls back to raster OpenStreetMap so the app
# works with no tile data to host.
#   - Local dev: drop a file in public/ and use e.g. /basemap.pmtiles
#   - Production: a DigitalOcean Spaces URL (configure CORS to allow Range
#     requests from your origin and expose Content-Range/Accept-Ranges)
VITE_BASEMAP_PMTILES_URL=
# Optional separate demo vector overlay archive.
VITE_DEMO_PMTILES_URL=
# Glyphs (fonts) and sprite endpoints the basemap style references.
VITE_GLYPHS_URL=https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf
VITE_SPRITE_URL=

# Backend environment variables. Copy to `.env` and fill in.
# `.env` is gitignored; this template is committed.

# ── Core ──────────────────────────────────────────────────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True

# ── Database ──────────────────────────────────────────────────────────────────
# Production (DO App Platform) injects a single DATABASE_URL from the managed
# Postgres component; leave it blank locally to use the POSTGRES_* values below.
# DATABASE_URL=
# DB_SSL_REQUIRE=True

POSTGRES_ENGINE=django.contrib.gis.db.backends.postgis
POSTGRES_DB=webgisdb
POSTGRES_USER=webgis
POSTGRES_PASSWORD=webgis
# In docker-compose this is the db service name; for a host Postgres use localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── URLs / hosts ──────────────────────────────────────────────────────────────
# Public origin of the frontend SPA (used for CORS and allauth email links).
FRONTEND_URL=http://localhost:5173
# Comma-separated. In prod set to your App Platform / custom domain.
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional explicit overrides (default to FRONTEND_URL when unset):
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ── TLS / proxy (prod only; ignored when DEBUG=True) ──────────────────────────
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# ── Logging ───────────────────────────────────────────────────────────────────
# Write logs to files under logs/ in addition to stdout (defaults to DEBUG).
# LOG_TO_FILE=True

# ── Email (allauth verification) ──────────────────────────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Celery / Redis (optional; tasks run eagerly when unset) ───────────────────
# REDIS_URL=redis://redis:6379/0
